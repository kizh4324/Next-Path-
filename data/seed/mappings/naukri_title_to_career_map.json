{
  "_meta": {
    "purpose": "Exact-match lookup from Naukri Job_Titles to career_library.id (FR-14, database-schema.md §3.2 A).",
    "matching_rule": "Case-insensitive exact match on the whitespace-normalized title. No fuzzy or substring matching: a guessed mapping would silently attribute one career's salary evidence to another. Unmatched titles are written to data/seed/unmapped_titles.log for review, never inferred.",
    "why_only_two_careers": "This dataset was scraped with 'Data Science' and 'Data Analytics' queries. Titles like 'software engineer' or 'python developer' appear in it only because they sit inside data teams. Mapping those onto the software-developer career would attribute a data-science-biased sample to a career the dataset never sampled, producing evidence that looks sourced but is not. Careers outside these two are left with no market snapshot and the API returns an explicit missing-evidence state instead.",
    "excluded_titles": "Rows whose title is literally 'none' (about 9,900 of them) are malformed scrapes and are counted as excluded, not unmapped.",
    "coverage_note": "These entries cover roughly 56% of the 73,196 valid postings. The remainder are long-tail titles reported in the unmapped log.",
    "last_reviewed_date": "2026-08-20"
  },
  "excluded_title_values": ["none", "n/a", "na", "-"],
