# ---------------------------------------------------------------------------
# Next_Path — environment template
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- PostgreSQL 16 (docker-compose reads these for the db service) ---
POSTGRES_USER=nextpath
POSTGRES_PASSWORD=nextpath
POSTGRES_DB=nextpath

# --- Backend ---
# Inside docker-compose the host is `db`. For a locally installed Postgres use localhost.
DATABASE_URL=postgresql+asyncpg://nextpath:nextpath@db:5432/nextpath

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM provider (FR-16 chatbot, FR-17 parent summary) ---
# Both are optional. Leave both blank and the app still runs end to end: the parent
# summary falls back to a deterministic template and the chatbot returns an explicit
# "AI unavailable" state rather than inventing an answer.
#
# GEMINI_API_KEY takes priority when set. Anthropic is used when only that key exists.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=30

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Seed ingestion (Story 1.3) ---
# Raw vendor datasets. Inside docker-compose these are mounted read-only at /Dataset.
DATASET_ROOT=../Dataset
SEED_ROOT=../data/seed
SEED_LAST_VERIFIED_DATE=2026-08-20

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
