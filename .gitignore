# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Node / JS dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables & secrets
.env
.env.local
.env.*.local

# Operating System files
.DS_Store
Thumbs.db

# BMad user-specific configurations
*.user.toml

# Graphify temporary cache & dotfiles
graphify-out/.*
graphify-out/cache/



# Python virtual environments
.venv/
venv/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Frontend build output
frontend/dist/
frontend/dev-dist/
frontend/.vite/

# Seed run artefacts (regenerated by the builders)
data/seed/unmapped_titles.log

# Local development SQLite database (dev_bootstrap.py). Contains demo credentials
# and is regenerated on demand — never commit it.
*.db
*.db-journal
*.sqlite3

# TypeScript incremental build cache
*.tsbuildinfo
